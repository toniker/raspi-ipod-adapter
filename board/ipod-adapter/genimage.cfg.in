image boot.vfat {
	vfat {
		files = {
#BOOT_FILES#
		}
	}

	size = 64M
}

# The only mutable state in the system (D3): BlueZ's persisted pairing
# keys, mounted at /var/lib/bluetooth by board/ipod-adapter's S32bt-data
# init script. Everything else lives in the initramfs (D2) or on tmpfs
# (D4) and is discarded on power loss.
image data.ext4 {
	ext4 {
		label = "btdata"
	}

	size = 8M
}

image sdcard.img {
	hdimage {
	}

	partition boot {
		partition-type = 0xC
		bootable = "true"
		image = "boot.vfat"
	}

	partition data {
		partition-type = 0x83
		image = "data.ext4"
	}
}
